      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The seal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sello"
          }
        }
      }
    },
    "The seal covers the previous seal, so altering any earlier event breaks every seal after it.": {
      "comment": "Introduced by the Swift port; not present in the prototype.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The seal covers the previous seal, so altering any earlier event breaks every seal after it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sello cubre al sello anterior, de modo que alterar cualquier evento previo rompe todos los sellos posteriores."
          }
        }
      }
    },
    "The supplier billed more than the distribution centre received. Draft the supplier inquiry with the receiving record attached; do not pay the difference.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
