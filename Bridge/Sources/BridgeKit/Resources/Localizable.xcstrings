    "I am Taylor, the assistant in the room. I read the ledger, the invoices, the cases, the rack, and the sun, and I answer in plain words. Ask me anything about this cluster, or anything at all; I have a question of my own for you when we are done.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am Taylor, the assistant in the room. I read the ledger, the invoices, the cases, the rack, and the sun, and I answer in plain words. Ask me anything about this cluster, or anything at all; I have a question of my own for you when we are done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soy Taylor, la asistente en la sala. Leo el libro, las facturas, los casos, el rack y el sol, y respondo en palabras llanas. Pregúnteme lo que sea de este clúster, o lo que sea; yo tengo una pregunta para usted cuando terminemos."
          }
        }
      }
    },
    "I am Taylor. I answer from the records this console holds, and every reply says where it came from.": {
      "comment": "Introduced by the Swift port; not present in the prototype.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am Taylor. I answer from the records this console holds, and every reply says where it came from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soy Taylor. Respondo a partir de los registros que guarda esta consola, y cada respuesta indica de dónde proviene."
          }
        }
      }
    },
