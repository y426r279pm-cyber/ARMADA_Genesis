    "Fit and speed on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fit and speed on"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste y velocidad en"
          }
        }
      }
    },
    "Fit: weights = parameters × bits ÷ 8, resident in one node or one octet with 15 percent held for KV cache and runtime. Speed: memory bandwidth (M3 Ultra 819 GB/s, M5 Ultra 1.2 TB/s) × 0.5 across an octet over RDMA or 0.7 on one node, ÷ bytes per token of the active parameters; calibrated to Kimi K2 at 25 to 32 tok/s on an M3 Ultra octet (Geerling, Dec 2025). Analogies: developer statements plus Artificial Analysis where available, dated.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fit: weights = parameters × bits ÷ 8, resident in one node or one octet with 15 percent held for KV cache and runtime. Speed: memory bandwidth (M3 Ultra 819 GB/s, M5 Ultra 1.2 TB/s) × 0.5 across an octet over RDMA or 0.7 on one node, ÷ bytes per token of the active parameters; calibrated to Kimi K2 at 25 to 32 tok/s on an M3 Ultra octet (Geerling, Dec 2025). Analogies: developer statements plus Artificial Analysis where available, dated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste: pesos = parámetros × bits ÷ 8, residentes en un nodo o un octeto con 15 por ciento reservado para caché KV y runtime. Velocidad: ancho de banda de memoria (M3 Ultra 819 GB/s, M5 Ultra 1.2 TB/s) × 0.5 en un octeto por RDMA o 0.7 en un nodo, ÷ bytes por token de los parámetros activos; calibrado con Kimi K2 a 25-32 tok/s en un octeto M3 Ultra (Geerling, dic 2025). Analogías: dichos del desarrollador más Artificial Analysis cuando existe, con fecha."
          }
        }
      }
    },
